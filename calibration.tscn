[node name="LivePanel" type="PanelContainer" parent="RootVBox/ContentContainer/Column"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBox_live_panel")

[node name="LiveVBox" type="VBoxContainer" parent="RootVBox/ContentContainer/Column/LivePanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LiveValueLabel" type="Label" parent="RootVBox/ContentContainer/Column/LivePanel/LiveVBox"]
