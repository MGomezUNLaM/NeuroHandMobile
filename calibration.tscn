horizontal_alignment = 1

[node name="CalibProgress" type="ProgressBar" parent="RootVBox/ContentContainer/Column/ProgressVBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBox_progress_bg")
theme_override_styles/fill = SubResource("StyleBox_progress_fill")
max_value = 10.0
