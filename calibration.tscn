content_margin_bottom = 14.0
bg_color = Color(0, 0.36, 0.37, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

[sub_resource type="StyleBoxFlat" id="StyleBox_btn_teal_pressed"]
content_margin_top = 14.0
content_margin_bottom = 14.0
bg_color = Color(0, 0.28, 0.29, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22

[node name="Calibration" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="RootVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="HeaderContainer" type="MarginContainer" parent="RootVBox"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 14

[node name="HeaderHBox" type="HBoxContainer" parent="RootVBox/HeaderContainer"]
layout_mode = 2

[node name="HeaderVBox" type="VBoxContainer" parent="RootVBox/HeaderContainer/HeaderHBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="CategoryLabel" type="Label" parent="RootVBox/HeaderContainer/HeaderHBox/HeaderVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.118, 0.596, 0.647, 1)
theme_override_font_sizes/font_size = 14
text = "CALIBRACIÓN SECUENCIAL"

[node name="TitleLabel" type="Label" parent="RootVBox/HeaderContainer/HeaderHBox/HeaderVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.067, 0.157, 0.235, 1)
theme_override_font_sizes/font_size = 22
text = "Calibrar sensores del guante"

[node name="BtnBack" type="Button" parent="RootVBox/HeaderContainer/HeaderHBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 36)
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.4, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 15
text = "← Volver"
flat = true

[node name="HeaderDivider" type="ColorRect" parent="RootVBox"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.88, 0.88, 0.88, 1)

[node name="ContentContainer" type="MarginContainer" parent="RootVBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="Column" type="VBoxContainer" parent="RootVBox/ContentContainer"]
layout_mode = 2
size_flags_horizontal = 3
