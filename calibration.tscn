[node name="ProgressVBox" type="VBoxContainer" parent="RootVBox/ContentContainer/Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ProgLabel" type="Label" parent="RootVBox/ContentContainer/Column/ProgressVBox"]
