theme_override_styles/pressed = SubResource("StyleBox_btn_teal_pressed")
text = "Siguiente"

[node name="FooterNote" type="Label" parent="RootVBox/ContentContainer/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.65, 0.65, 1)
theme_override_font_sizes/font_size = 12
text = "Asegurate de que el guante esté conectado y bien colocado"
horizontal_alignment = 1
