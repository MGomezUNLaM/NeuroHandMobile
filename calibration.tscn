[node name="InstructionSubtitle" type="Label" parent="RootVBox/ContentContainer/Column/InstructionsVBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 14
text = "Mantené el pulgar completamente extendido y relajado."
horizontal_alignment = 1
