[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://calibration.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/icons/hand_open_calib.png" id="2_hand_open"]

[sub_resource type="StyleBoxFlat" id="StyleBox_progress_bg"]
bg_color = Color(0.92, 0.95, 0.95, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 0.9, 0.9, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="StyleBox_progress_fill"]
