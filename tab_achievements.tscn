[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://tab_achievements.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBox_filter_active"]
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0
bg_color = Color(0.118, 0.596, 0.647, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[sub_resource type="StyleBoxFlat" id="StyleBox_filter"]
content_margin_left = 16.0
content_margin_top = 8.0
content_margin_right = 16.0
content_margin_bottom = 8.0
bg_color = Color(0.92, 0.95, 0.97, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14

[node name="TabAchievements" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.973, 0.984, 0.992, 1)

[node name="MainVBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 18.0
offset_right = -20.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="HeaderVBox" type="VBoxContainer" parent="MainVBox"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Category" type="Label" parent="MainVBox/HeaderVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.118, 0.596, 0.647, 1)
theme_override_font_sizes/font_size = 12
text = "PROGRESO Y RECOMPENSAS"

[node name="Title" type="Label" parent="MainVBox/HeaderVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.067, 0.157, 0.235, 1)
theme_override_font_sizes/font_size = 22
text = "Logros y Medallas"

[node name="FilterRow" type="HBoxContainer" parent="MainVBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FilterAll" type="Button" parent="MainVBox/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBox_filter_active")
text = "Todos"

[node name="FilterBronce" type="Button" parent="MainVBox/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.40, 0.50, 0.55, 1)
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBox_filter")
text = "Bronce"

[node name="FilterPlata" type="Button" parent="MainVBox/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.40, 0.50, 0.55, 1)
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBox_filter")
text = "Plata"

[node name="FilterOro" type="Button" parent="MainVBox/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.40, 0.50, 0.55, 1)
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("StyleBox_filter")
text = "Oro"

[node name="Scroll" type="ScrollContainer" parent="MainVBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="AchievementsList" type="VBoxContainer" parent="MainVBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[connection signal="pressed" from="MainVBox/FilterRow/FilterAll" to="." method="_on_filter_pressed" binds= ["Todos"]]
[connection signal="pressed" from="MainVBox/FilterRow/FilterBronce" to="." method="_on_filter_pressed" binds= ["Bronce"]]
[connection signal="pressed" from="MainVBox/FilterRow/FilterPlata" to="." method="_on_filter_pressed" binds= ["Plata"]]
[connection signal="pressed" from="MainVBox/FilterRow/FilterOro" to="." method="_on_filter_pressed" binds= ["Oro"]]
